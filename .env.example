# Public development examples only. Copy to .env and replace before future use.
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me-local-db
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=change-me-local-broker
# Replace with random application secrets before running implemented services.
APP_SECRET_KEY=change-me-local-app-secret
OUTBOX_ENCRYPTION_KEY=change-me-local-outbox-key
IDEMPOTENCY_ENCRYPTION_KEY=change-me-local-idempotency-key
PUBLIC_APP_URL=http://localhost:8080
